<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="SentryMission">

  <!-- ============================================================ -->
  <!-- RC_2026_1 R2任务行为树 -->
  <!-- 基础路径点巡逻框架 -->
  <!-- ============================================================ -->

  <BehaviorTree ID="SentryMission">
    <SubTree ID="WaypointPatrol"/>
  </BehaviorTree>

  <!-- 路径点巡逻子树 -->
  <BehaviorTree ID="WaypointPatrol">
    <Sequence>
      <WaypointQueue advance="false"
                     current_waypoint="{goal}"
                     action_type="{action_type}"
                     waypoint_name="{waypoint_name}"
                     waypoint_index="{index}"
                     total_waypoints="{total}"/>

      <KeepRunningUntilFailure>
        <Sequence>
          <Nav2Client goal="{goal}"/>
          <WaypointActionExecutor action_type="{action_type}"
                                  waypoint_name="{waypoint_name}"
                                  success="{action_success}"/>
          <WaypointQueue advance="true"
                         current_waypoint="{goal}"
                         action_type="{action_type}"
                         waypoint_name="{waypoint_name}"
                         waypoint_index="{index}"
                         total_waypoints="{total}"/>
        </Sequence>
      </KeepRunningUntilFailure>
    </Sequence>
  </BehaviorTree>

</root>
