Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: RegisteredScan
      Topic:
        Value: /registered_scan
        Queue Size: 5
      Value: true
      Size (m): 0.02
      Style: Points
      Color Transformer: Intensity
      Reliability Policy: Best Effort
    - Class: rviz_default_plugins/PointCloud2
      Name: TerrainObstacles
      Topic:
        Value: /terrain_obstacles
        Queue Size: 5
      Value: true
      Size (m): 0.03
      Style: Points
      Color Transformer: FlatColor
      Color: 220; 0; 0
      Reliability Policy: Best Effort
    - Class: rviz_default_plugins/PointCloud2
      Name: TerrainDrop
      Topic:
        Value: /terrain_drop
        Queue Size: 5
      Value: true
      Size (m): 0.03
      Style: Points
      Color Transformer: FlatColor
      Color: 0; 80; 220
      Reliability Policy: Best Effort
    - Class: rviz_default_plugins/PointCloud2
      Name: TerrainClimbable
      Topic:
        Value: /terrain_climbable
        Queue Size: 5
      Value: true
      Size (m): 0.03
      Style: Points
      Color Transformer: FlatColor
      Color: 0; 200; 0
      Reliability Policy: Best Effort
  Global Options:
    # 参数说明：Fixed Frame - RViz 固定坐标系；所有显示项会转换到该 frame。
    Fixed Frame: odom
    # 参数说明：Frame Rate - RViz 刷新帧率；影响界面更新频率。
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      # 参数说明：Distance - 几何距离参数，单位通常为米。
      Distance: 12
      # 参数说明：Pitch - 俯仰角；单位按该配置约定。
      Pitch: 0.6
      # 参数说明：Yaw - 偏航角；单位按该配置约定，导航图中通常为弧度。
      Yaw: 0
