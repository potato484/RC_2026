Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: RegisteredScan
      Topic:
        Value: /registered_scan
        Queue Size: 5
      Value: true
      Size (m): 0.02
      Style: Points
      Color Transformer: Intensity
      Reliability Policy: Best Effort
    - Class: rviz_default_plugins/PointCloud2
      Name: TerrainObstacles
      Topic:
        Value: /terrain_obstacles
        Queue Size: 5
      Value: true
      Size (m): 0.03
      Style: Points
      Color Transformer: FlatColor
      Color: 220; 0; 0
      Reliability Policy: Best Effort
    - Class: rviz_default_plugins/PointCloud2
      Name: TerrainDrop
      Topic:
        Value: /terrain_drop
        Queue Size: 5
      Value: true
      Size (m): 0.03
      Style: Points
      Color Transformer: FlatColor
      Color: 0; 80; 220
      Reliability Policy: Best Effort
    - Class: rviz_default_plugins/PointCloud2
      Name: TerrainClimbable
      Topic:
        Value: /terrain_climbable
        Queue Size: 5
      Value: true
      Size (m): 0.03
      Style: Points
      Color Transformer: FlatColor
      Color: 0; 200; 0
      Reliability Policy: Best Effort
  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Pitch: 0.6
      Yaw: 0
