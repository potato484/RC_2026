  <version>1.0.0</version>
  <description>R2 定位感知 NMPC 控制器（含回退到 rc26_omni_controller）</description>
  <maintainer email="dev@rc2026.com">RC2026</maintainer>
  <maintainer email="2220362462@qq.com">DongXuan Chen</maintainer>
  <license>Apache-2.0</license>

  <author email="2220362462@qq.com">DongXuan Chen</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>nav2_common</depend>
  <depend>nav2_core</depend>
  <depend>nav2_util</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>rclcpp</depend>
  <depend>pluginlib</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
