Panels:
  - Class: rviz_common/Displays
    Name: 显示
  - Class: rviz_common/Views
    Name: 视角
  - Class: rviz_common/Time
    Name: 时间
Visualization Manager:
  Displays:
    - Class: rviz_common/Group
      Name: 场景基础
      Displays:
        - Class: rviz_default_plugins/Grid
          Name: 地面网格
          Value: true
        - Class: rviz_default_plugins/TF
          Name: TF
          Value: true
        - Class: rviz_default_plugins/RobotModel
          Name: 机器人
          Value: true
    - Class: rviz_common/Group
      Name: 导航态势
      Displays:
        - Class: rviz_default_plugins/Path
          Name: 全局路线
          Topic:
            Value: /xhu_nav/route
          Value: true
        - Class: rviz_default_plugins/Path
          Name: 走廊
          Topic:
            Value: /xhu_nav/corridor
          Value: true
        - Class: rviz_default_plugins/Path
          Name: 预瞄路径
          Topic:
            Value: /xhu_nav/lookahead_path
          Value: true
        - Class: rviz_default_plugins/MarkerArray
          Name: 风险来源
          Topic:
            Value: /xhu_nav/risk_markers
          Value: true
    - Class: rviz_common/Group
      Name: 点云诊断
      Displays:
        - Class: rviz_default_plugins/PointCloud2
          Name: 点云配准
          Topic:
            Value: registered_scan
            Queue Size: 5
          Value: true
          Size (m): 0.03
          Style: Points
          Color Transformer: Intensity
          Reliability Policy: Best Effort
        - Class: rviz_default_plugins/PointCloud2
          Name: 地形障碍
          Topic:
            Value: terrain_obstacles
            Queue Size: 5
          Value: true
          Size (m): 0.05
          Style: Points
          Color: 255; 120; 80
          Color Transformer: FlatColor
          Reliability Policy: Best Effort
        - Class: rviz_default_plugins/PointCloud2
          Name: 地形跌落
          Topic:
            Value: terrain_drop
            Queue Size: 5
          Value: true
          Size (m): 0.05
          Style: Points
          Color: 80; 160; 255
          Color Transformer: FlatColor
          Reliability Policy: Best Effort
    - Class: rviz_common/Group
      Name: 地形安全
      Displays:
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Class: grid_map_rviz_plugin/GridMap
          Color Layer: traversability
          Color Transformer: GridMapLayer
          Height Layer: elevation_abs
          Height Transformer: GridMapLayer
          Name: 地形栅格
          Topic:
            Value: terrain_grid_map
          Value: true
        - Class: rviz_default_plugins/Map
          Name: 保持禁行区
          Topic:
            Value: /kfs_filter_mask
          Value: true
  Global Options:
    Fixed Frame: map
    Frame Rate: 20
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic: initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic: goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 16
      Pitch: 1.2
      Yaw: 0.15
