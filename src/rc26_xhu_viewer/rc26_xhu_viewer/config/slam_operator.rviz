Panels:
  - Class: rviz_common/Displays
    Name: 显示
  - Class: rviz_common/Views
    Name: 视角
  - Class: rviz_common/Time
    Name: 时间
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: 地面网格
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: 激光地图
      Topic:
        Value: laser_map_full
        Queue Size: 1
      Value: true
      Size (m): 0.04
      Style: Points
      Color: 80; 255; 120
      Color Transformer: FlatColor
      Reliability Policy: Best Effort
    - Class: rviz_default_plugins/PointCloud2
      Name: 匹配点云
      Topic:
        Value: registered_scan
        Queue Size: 5
      Value: true
      Size (m): 0.03
      Style: Points
      Color Transformer: Intensity
      Reliability Policy: Best Effort
    - Alpha: 1
      Class: rviz_default_plugins/Path
      Color: 220; 60; 60
      Name: 里程轨迹
      Topic:
        Value: odom_path
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/Path
      Color: 60; 220; 60
      Name: 控制轨迹
      Topic:
        Value: control_path
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: grid_map_rviz_plugin/GridMap
      Color Layer: traversability
      Color Transformer: GridMapLayer
      Height Layer: elevation_abs
      Height Transformer: GridMapLayer
      Name: 局部地形
      Topic:
        Value: terrain_grid_map_local
      Value: true
    - Class: rviz_default_plugins/Map
      Name: 保持禁行区
      Topic:
        Value: /kfs_filter_mask
      Value: true
  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
      Pitch: 0.785
      Yaw: 0
