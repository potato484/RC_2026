<!--
  第二预选赛 KFS 兼容上阶树：
  - managed 入口握手仍由 second_preselection_kfs_compat_combo_tree.xml 完成。
  - 树首依次放下机械臂、停车稳定、沿 +X 前进 1.5m、执行 KFS 夹取；不启用视觉搜索或验证。
  - 机构命令失败时沿用 SecondPreselectionCommand 的告警续跑语义。
  - 后轮段完成后立即处理后推杆收回 0x0B；从进入收尾阶段起等待 25s，
    fire-and-forget 下发 0x15，固定等待 10s，再可靠下发最终 0x13。
  - 运行前必须停用遥控、独立台阶测试等其它 /cmd_vel 发布权威。
-->
<root BTCPP_format="4" main_tree_to_execute="SecondPreselectionKfsCompatClimbPlaceTree">
  <BehaviorTree ID="SecondPreselectionKfsCompatClimbPlaceTree">
    <Sequence name="second_preselection_kfs_compat_climb_place_sequence">
      <SecondPreselectionCommand
          name="second_preselection_kfs_compat_lower_arm"
          command_id="{second_preselect_pre_approach_lower_command_id}"
          done_feedback_id="{second_preselect_pre_approach_lower_done_feedback_id}"
          command_timeout_s="{second_preselect_command_timeout_s}"
          done_timeout_s="{second_preselect_done_timeout_s}"
          label="second_preselection_kfs_compat_lower_arm"/>

      <Delay delay_msec="{second_preselect_pre_approach_lower_settle_msec}">
        <AlwaysSuccess name="second_preselection_kfs_compat_lower_settled"/>
      </Delay>

      <OdomDriveX name="second_preselection_kfs_compat_climb_place_forward"
                  distance_m="{second_preselect_climb_place_forward_x_m}"
                  cmd_vel_topic="{odom_relative_nav_cmd_vel_topic}"
                  odom_topic="{odom_relative_nav_odom_topic}"
                  max_speed_mps="{second_preselect_nav_max_speed_mps}"
                  min_speed_mps="{second_preselect_nav_min_speed_mps}"
                  xy_kp="{odom_relative_nav_xy_kp}"
                  heading_kp="{odom_relative_nav_heading_kp}"
                  heading_max_speed_radps="{odom_relative_nav_heading_max_speed_radps}"
                  xy_tolerance_m="{odom_relative_nav_xy_tolerance_m}"
                  yaw_tolerance_deg="{odom_relative_nav_yaw_tolerance_deg}"
                  stable_ticks="{odom_relative_nav_stable_ticks}"
                  odom_timeout_s="{odom_relative_nav_odom_timeout_s}"
                  succeed_on_reach_or_overshoot="true"
                  timeout_s="{second_preselect_nav_timeout_s}"/>

      <SecondPreselectionCommand
          name="second_preselection_kfs_compat_pickup"
          command_id="{second_preselect_pickup_command_id}"
          done_feedback_id="{second_preselect_pickup_done_feedback_id}"
          command_timeout_s="{second_preselect_command_timeout_s}"
          done_timeout_s="{second_preselect_done_timeout_s}"
          label="second_preselection_kfs_compat_pickup"/>

      <OdomDriveY name="second_preselection_kfs_compat_climb_place_lateral"
                  distance_m="{second_preselect_climb_place_lateral_y_m}"
                  cmd_vel_topic="{odom_relative_nav_cmd_vel_topic}"
                  odom_topic="{odom_relative_nav_odom_topic}"
                  max_speed_mps="{second_preselect_nav_max_speed_mps}"
                  min_speed_mps="{second_preselect_nav_min_speed_mps}"
                  xy_kp="{odom_relative_nav_xy_kp}"
                  heading_kp="{odom_relative_nav_heading_kp}"
                  heading_max_speed_radps="{odom_relative_nav_heading_max_speed_radps}"
                  xy_tolerance_m="{odom_relative_nav_xy_tolerance_m}"
                  yaw_tolerance_deg="{odom_relative_nav_yaw_tolerance_deg}"
                  stable_ticks="{odom_relative_nav_stable_ticks}"
                  odom_timeout_s="{odom_relative_nav_odom_timeout_s}"
                  succeed_on_reach_or_overshoot="true"
                  timeout_s="{second_preselect_nav_timeout_s}"/>

      <Delay delay_msec="{second_preselect_climb_place_pre_climb_delay_msec}">
        <SecondPreselectionClimbFrontStage
            name="second_preselection_kfs_compat_climb_place_front_stage"/>
      </Delay>

      <OdomDriveX name="second_preselection_kfs_compat_climb_place_rear_forward"
                  distance_m="{second_preselect_climb_place_rear_forward_x_m}"
                  cmd_vel_topic="{odom_relative_nav_cmd_vel_topic}"
                  odom_topic="{odom_relative_nav_odom_topic}"
                  max_speed_mps="{second_preselect_climb_place_rear_max_speed_mps}"
                  min_speed_mps="{second_preselect_climb_place_rear_min_speed_mps}"
                  xy_kp="{odom_relative_nav_xy_kp}"
                  heading_kp="{odom_relative_nav_heading_kp}"
                  heading_max_speed_radps="{odom_relative_nav_heading_max_speed_radps}"
                  xy_tolerance_m="{odom_relative_nav_xy_tolerance_m}"
                  yaw_tolerance_deg="{odom_relative_nav_yaw_tolerance_deg}"
                  stable_ticks="{odom_relative_nav_stable_ticks}"
                  odom_timeout_s="{odom_relative_nav_odom_timeout_s}"
                  succeed_on_reach_or_overshoot="true"
                  succeed_on_timeout="true"
                  timeout_s="{second_preselect_climb_place_rear_timeout_s}"/>

      <SecondPreselectionRearRetractCompatPickupPlace
          name="second_preselection_kfs_compat_climb_place_finish"/>
    </Sequence>
  </BehaviorTree>
</root>
