<!-- MC + 梅林预选赛组合入口：人工 0x06 启动 → 下发比赛开始 0x10 → 延时 → MC → MF 预选。 -->
<root BTCPP_format="4" main_tree_to_execute="MCMFPreselectionTree">

  <include path="mc_tree.xml"/>
  <include path="mf_preselection_after_mc_tree.xml"/>

  <BehaviorTree ID="MCMFPreselectionTree">
    <Sequence name="MC_MF_Preselection_Sequence">
      <WaitStartSignalAndNotify name="wait_start_signal_and_notify"/>
      <Delay delay_msec="500">
        <AlwaysSuccess/>
      </Delay>
      <SubTree ID="MCAreaTree" _autoremap="true"/>
      <SubTree ID="MFPreselectionAfterMCTree" _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

</root>
