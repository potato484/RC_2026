<!-- 梅林区行为树 (MF Area) - 离散格间动作版本 -->
<root BTCPP_format="4" main_tree_to_execute="MFAreaTree">
  <BehaviorTree ID="MFAreaTree">
    <Sequence name="MF_Main">
      <Script code="exit_grid:=10; current_grid:=2; mf_transition_error:=''"/>

      <SubTree ID="MF_Entry" _autoremap="true"/>
      <SubTree ID="MF_Loop" _autoremap="true"/>
      <SubTree ID="MF_Exit" _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

  <!-- MF_Entry: MF 外层流程需保证机器人已处于 grid2 的可执行姿态 -->
  <BehaviorTree ID="MF_Entry">
    <Sequence name="Entry_Seq">
      <Script code="current_grid:=2; mf_transition_error:=''"/>
    </Sequence>
  </BehaviorTree>

  <!-- MF_Loop: 核心循环 -->
  <BehaviorTree ID="MF_Loop">
    <KeepRunningUntilFailure>
      <Sequence name="Loop_Body">
        <Fallback>
          <Inverter>
            <CheckExitCondition/>
          </Inverter>
          <ForceFailure>
            <AlwaysSuccess/>
          </ForceFailure>
        </Fallback>

        <SelectNextGrid next_action="{next_action}" target_grid="{target_grid}"/>

        <Fallback>
          <Sequence>
            <ScriptCondition code="next_action=='MOVE'"/>
            <SubTree ID="MoveToGridSeq" _autoremap="true"/>
          </Sequence>
          <Delay delay_msec="1000">
            <AlwaysSuccess/>
          </Delay>
        </Fallback>
      </Sequence>
    </KeepRunningUntilFailure>
  </BehaviorTree>

  <!-- MoveToGridSeq: 规划格间 yaw，先转向/对齐，再执行离散上/下阶梯 -->
  <BehaviorTree ID="MoveToGridSeq">
    <Sequence>
      <PlanGridTransition target_grid="{target_grid}" target_yaw_rad="{grid_transition_target_yaw}"/>
      <GridTurn target_yaw_rad="{grid_transition_target_yaw}"/>
      <GridHeadingAlign target_yaw_rad="{grid_transition_target_yaw}"/>
      <GridTransition target_grid="{target_grid}"/>
    </Sequence>
  </BehaviorTree>

  <!-- MF_Exit: 到达出口格后，MF 离散流程完成 -->
  <BehaviorTree ID="MF_Exit">
    <Sequence name="Exit_Seq">
      <AlwaysSuccess/>
    </Sequence>
  </BehaviorTree>
</root>
