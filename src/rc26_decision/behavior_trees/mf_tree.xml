<!-- 梅林区行为树 (MF Area) - Nav2 pose 版本 -->
<root BTCPP_format="4">
  <BehaviorTree ID="MFAreaTree">
    <Sequence name="MF_Main">
      <Script code="target_kfs_count:=2; exit_grid:=10; kfs_on_board:=0; current_grid:=2"/>

      <SubTree ID="MF_Entry" _autoremap="true"/>
      <SubTree ID="MF_Loop" _autoremap="true"/>
      <SubTree ID="MF_Exit" _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

  <!-- MF_Entry: 进门阶段 -->
  <BehaviorTree ID="MF_Entry">
    <Sequence name="Entry_Seq">
      <NavToPose x="1.2" y="-0.6" yaw="1.5708"/>

      <RetryUntilSuccessful num_attempts="10">
        <Sequence>
          <ScanSurroundings/>
          <Fallback>
            <Inverter>
              <CheckR1Blocking/>
            </Inverter>
            <Sequence>
              <NavToPose x="1.2" y="-0.6" yaw="1.5708"/>
              <Delay delay_msec="5000">
                <AlwaysSuccess/>
              </Delay>
            </Sequence>
          </Fallback>
        </Sequence>
      </RetryUntilSuccessful>

      <NavToPose x="1.2" y="0.0" yaw="1.5708"/>
      <Script code="current_grid:=2"/>
    </Sequence>
  </BehaviorTree>

  <!-- MF_Loop: 核心循环 -->
  <BehaviorTree ID="MF_Loop">
    <KeepRunningUntilFailure>
      <Sequence name="Loop_Body">
        <Fallback>
          <Inverter>
            <CheckExitCondition/>
          </Inverter>
          <ForceFailure>
            <AlwaysSuccess/>
          </ForceFailure>
        </Fallback>

        <ScanSurroundings/>
        <SelectNextGrid next_action="{next_action}" target_grid="{target_grid}"/>

        <Fallback>
          <Sequence>
            <ScriptCondition code="next_action=='GRAB'"/>
            <SubTree ID="GrabKFSSeq" _autoremap="true"/>
          </Sequence>
          <Sequence>
            <ScriptCondition code="next_action=='MOVE'"/>
            <SubTree ID="MoveToGridSeq" _autoremap="true"/>
          </Sequence>
          <Delay delay_msec="1000">
            <AlwaysSuccess/>
          </Delay>
        </Fallback>
      </Sequence>
    </KeepRunningUntilFailure>
  </BehaviorTree>

  <!-- GrabKFSSeq: 抓取子树 -->
  <BehaviorTree ID="GrabKFSSeq">
    <Sequence>
      <SubTree ID="NavToSelectedGrid" _autoremap="true"/>
      <Script code="current_grid:=target_grid"/>
      <GrabKFS/>
      <IncrementKFSCount/>
      <UpdateMapKFS grid_id="{target_grid}" kfs_type="0"/>
    </Sequence>
  </BehaviorTree>

  <!-- MoveToGridSeq: 移动子树 -->
  <BehaviorTree ID="MoveToGridSeq">
    <Sequence>
      <SubTree ID="NavToSelectedGrid" _autoremap="true"/>
      <Script code="current_grid:=target_grid"/>
    </Sequence>
  </BehaviorTree>

  <!-- NavToSelectedGrid: target_grid -> Nav2 pose -->
  <BehaviorTree ID="NavToSelectedGrid">
    <Fallback>
      <Sequence>
        <ScriptCondition code="target_grid==1"/>
        <NavToPose x="0.0" y="0.0" yaw="1.5708"/>
      </Sequence>
      <Sequence>
        <ScriptCondition code="target_grid==2"/>
        <NavToPose x="1.2" y="0.0" yaw="1.5708"/>
      </Sequence>
      <Sequence>
        <ScriptCondition code="target_grid==3"/>
        <NavToPose x="2.4" y="0.0" yaw="1.5708"/>
      </Sequence>
      <Sequence>
        <ScriptCondition code="target_grid==4"/>
        <NavToPose x="0.0" y="1.2" yaw="1.5708"/>
      </Sequence>
      <Sequence>
        <ScriptCondition code="target_grid==5"/>
        <NavToPose x="1.2" y="1.2" yaw="1.5708"/>
      </Sequence>
      <Sequence>
        <ScriptCondition code="target_grid==6"/>
        <NavToPose x="2.4" y="1.2" yaw="1.5708"/>
      </Sequence>
      <Sequence>
        <ScriptCondition code="target_grid==7"/>
        <NavToPose x="0.0" y="2.4" yaw="1.5708"/>
      </Sequence>
      <Sequence>
        <ScriptCondition code="target_grid==8"/>
        <NavToPose x="1.2" y="2.4" yaw="1.5708"/>
      </Sequence>
      <Sequence>
        <ScriptCondition code="target_grid==9"/>
        <NavToPose x="2.4" y="2.4" yaw="1.5708"/>
      </Sequence>
      <Sequence>
        <ScriptCondition code="target_grid==10"/>
        <NavToPose x="0.0" y="3.6" yaw="1.5708"/>
      </Sequence>
      <Sequence>
        <ScriptCondition code="target_grid==11"/>
        <NavToPose x="1.2" y="3.6" yaw="1.5708"/>
      </Sequence>
      <Sequence>
        <ScriptCondition code="target_grid==12"/>
        <NavToPose x="2.4" y="3.6" yaw="1.5708"/>
      </Sequence>
    </Fallback>
  </BehaviorTree>

  <!-- MF_Exit: 出门阶段 -->
  <BehaviorTree ID="MF_Exit">
    <Sequence name="Exit_Seq">
      <NavToPose x="1.2" y="4.2" yaw="1.5708"/>
      <StairDescend/>
    </Sequence>
  </BehaviorTree>
</root>
