<!--
  梅林区预选赛专属行为树：
  - 入口导航由 r2_runtime.yaml 的 mf_preselect_entry2_nav_enable 控制。
  - 入口导航成功后会执行 GridTurn -> GridHeadingAlign，对齐 grid_heading_* 选出的 yaw。
  - MfPreselectionFlow 内部独占发布 cmd_vel，并通过 /mechanism/send_command 消费机构 raw transport。
  - 流程成功驶出梅林后进入 WaitForever，保持永久静止。
-->
<root BTCPP_format="4" main_tree_to_execute="MFPreselectionTree">
  <BehaviorTree ID="MFPreselectionTree">
    <Sequence name="MF_Preselection_Sequence">
      <Fallback name="Optional_Entry2_Navigation">
        <Sequence name="Entry2_Navigation_When_Enabled">
          <ScriptCondition code="mf_preselect_entry2_nav_enable"/>
          <NavToPose x="{mf_preselect_entry2_nav_x}"
                     y="{mf_preselect_entry2_nav_y}"
                     yaw="{mf_preselect_entry2_nav_yaw}"
                     frame_id="{mf_preselect_entry2_nav_frame_id}"
                     timeout_sec="{mf_preselect_entry2_nav_timeout_sec}"
                     behavior_tree="{mf_preselect_entry2_nav_behavior_tree_file}"/>
          <GridTurn name="entry2_grid_turn" target_yaw_rad="{grid_heading_target_yaw_rad}"/>
          <GridHeadingAlign name="entry2_grid_heading_align" target_yaw_rad="{grid_heading_target_yaw_rad}"/>
        </Sequence>
        <Inverter>
          <ScriptCondition code="mf_preselect_entry2_nav_enable"/>
        </Inverter>
      </Fallback>
      <MfPreselectionFlow name="mf_preselection_flow"/>
      <WaitForever name="mf_preselection_wait_forever"/>
    </Sequence>
  </BehaviorTree>
</root>
