<!--
  带启动 gate 的梅林区预选赛专属行为树：
  - 先复用 WaitStartSignalAndNotify 等待人工 0x06，通知下位机比赛开始并等待 0x0C 完成反馈。
  - 后续入口导航与 mf_preselection_tree.xml 保持一致，由 mf_preselect_entry2_nav_enable 控制。
  - 本树不作为默认入口；需要该启动 gate 时显式选择本 XML。
  - MfPreselectionFlow 内部独占发布 cmd_vel，并通过 /mechanism/send_command 消费机构 raw transport。
  - 流程成功驶出梅林后进入 WaitForever，保持永久静止。
-->
<root BTCPP_format="4" main_tree_to_execute="MFPreselectionStartTree">
  <BehaviorTree ID="MFPreselectionStartTree">
    <Sequence name="MF_Preselection_Start_Sequence">
      <WaitStartSignalAndNotify name="wait_start_signal_and_notify"/>
      <Fallback name="Optional_Entry2_Navigation">
        <Sequence name="Entry2_Navigation_When_Enabled">
          <ScriptCondition code="mf_preselect_entry2_nav_enable"/>
          <OdomDriveX distance_m="{mf_preselect_entry2_nav_segment1_x_m}"
                      cmd_vel_topic="{odom_relative_nav_cmd_vel_topic}"
                      odom_topic="{odom_relative_nav_odom_topic}"
                      max_speed_mps="{odom_relative_nav_max_speed_mps}"
                      min_speed_mps="{odom_relative_nav_min_speed_mps}"
                      xy_kp="{odom_relative_nav_xy_kp}"
                      heading_kp="{odom_relative_nav_heading_kp}"
                      heading_max_speed_radps="{odom_relative_nav_heading_max_speed_radps}"
                      xy_tolerance_m="{odom_relative_nav_xy_tolerance_m}"
                      yaw_tolerance_deg="{odom_relative_nav_yaw_tolerance_deg}"
                      stable_ticks="{odom_relative_nav_stable_ticks}"
                      odom_timeout_s="{odom_relative_nav_odom_timeout_s}"
                      timeout_s="{mf_preselect_entry2_nav_timeout_sec}"/>
          <OdomDriveY distance_m="{mf_preselect_entry2_nav_segment1_y_m}"
                      cmd_vel_topic="{odom_relative_nav_cmd_vel_topic}"
                      odom_topic="{odom_relative_nav_odom_topic}"
                      max_speed_mps="{odom_relative_nav_max_speed_mps}"
                      min_speed_mps="{odom_relative_nav_min_speed_mps}"
                      xy_kp="{odom_relative_nav_xy_kp}"
                      heading_kp="{odom_relative_nav_heading_kp}"
                      heading_max_speed_radps="{odom_relative_nav_heading_max_speed_radps}"
                      xy_tolerance_m="{odom_relative_nav_xy_tolerance_m}"
                      yaw_tolerance_deg="{odom_relative_nav_yaw_tolerance_deg}"
                      stable_ticks="{odom_relative_nav_stable_ticks}"
                      odom_timeout_s="{odom_relative_nav_odom_timeout_s}"
                      timeout_s="{mf_preselect_entry2_nav_timeout_sec}"/>
        </Sequence>
        <Inverter>
          <ScriptCondition code="mf_preselect_entry2_nav_enable"/>
        </Inverter>
      </Fallback>
      <MfPreselectionFlow name="mf_preselection_flow"/>
      <WaitForever name="mf_preselection_start_wait_forever"/>
    </Sequence>
  </BehaviorTree>
</root>
