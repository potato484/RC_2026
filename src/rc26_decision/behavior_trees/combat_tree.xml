<!-- 对抗区子树 (Combat Area) -->
<root BTCPP_format="4">
  <BehaviorTree ID="CombatAreaTree">
    <Sequence name="Combat_Sequence">
      <!-- 跟随或导航到对抗区 -->
      <Fallback name="goto_combat">
        <FollowManualRobot follow_distance="1.5" lost_timeout="5.0"/>
        <!-- TODO: 预设路径导航 -->
      </Fallback>
      <!-- 放置 KFS -->
      <Sequence name="place_sequence">
        <PlaceKFSGrid grid_position="5"/>
      </Sequence>
    </Sequence>
  </BehaviorTree>
</root>
