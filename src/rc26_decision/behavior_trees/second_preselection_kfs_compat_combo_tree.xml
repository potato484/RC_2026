<!-- second managed KFS 搜索兼容入口：
  0x06 → 0x11/0x0D → 斜坡前进并停车 → 等 0x10 → 0x11/0x0D → 切换 KFS 搜索兼容上阶树；
  0x10 → 0x11/0x0D → 直接切换 KFS 搜索兼容上阶树。
-->
<root BTCPP_format="4" main_tree_to_execute="SecondPreselectionKfsCompatComboTree">

  <include path="preselection_ramp_forward_tree.xml"/>

  <BehaviorTree ID="SecondPreselectionKfsCompatComboTree">
    <Sequence name="second_preselection_kfs_compat_combo_sequence">
      <WaitPreselectionBranchGate name="second_preselection_kfs_compat_entry_branch_gate"
                                  continue_start_profile="second"
                                  switch_start_profile="second"
                                  switch_tree_file="second_preselection_kfs_compat_climb_place_tree.xml"/>
      <SubTree ID="PreselectionRampForwardTree" _autoremap="true"/>
      <WaitPreselectionBranchGate name="second_preselection_kfs_compat_after_ramp_gate"
                                  accepted_branch="switch_only"
                                  switch_start_profile="second"
                                  switch_tree_file="second_preselection_kfs_compat_climb_place_tree.xml"/>
    </Sequence>
  </BehaviorTree>
</root>
