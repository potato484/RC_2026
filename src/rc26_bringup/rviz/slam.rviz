Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: LaserMapFull
      Topic:
        Value: laser_map_full
        Queue Size: 1
      Value: true
      Size (m): 0.04
      Style: Points
      Color: 80; 255; 120
      Color Transformer: FlatColor
      Reliability Policy: Best Effort
    - Class: rviz_default_plugins/PointCloud2
      Name: RegisteredCloud
      Topic:
        Value: registered_scan
        Queue Size: 5
      Value: true
      Size (m): 0.03
      Style: Points
      Color Transformer: Intensity
      Reliability Policy: Best Effort
    - Alpha: 1
      Class: rviz_default_plugins/Path
      Color: 220; 60; 60
      Name: OdomPath
      Topic:
        Value: odom_path
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/Path
      Color: 60; 220; 60
      Name: ControlPath
      Topic:
        Value: control_path
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: OdomPoseMarkers
      Topic:
        Value: odom_pose_markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: ControlPoseMarkers
      Topic:
        Value: control_pose_markers
      Value: true
    - Class: rviz_default_plugins/PointStamped
      Name: LookaheadPoint
      Topic:
        Value: lookahead_point
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: CurvatureMarkers
      Topic:
        Value: curvature_points_marker_array
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: grid_map_rviz_plugin/GridMap
      Color: 200; 200; 200
      Color Layer: traversability
      Color Transformer: GridMapLayer
      # 参数说明：Height Layer - 几何距离参数，单位通常为米。
      Height Layer: elevation_abs
      # 参数说明：Height Transformer - 几何距离参数，单位通常为米。
      Height Transformer: GridMapLayer
      Name: TerrainGridMapLocal
      Topic:
        Value: terrain_grid_map_local
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: TerrainGridMapLocalMarkers
      Topic:
        Value: terrain_grid_map_local_markers
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: TerrainObstacles
      Topic:
        Value: terrain_obstacles
        Queue Size: 5
      Value: true
      Size (m): 0.05
      Style: Points
      Color: 255; 120; 80
      Color Transformer: FlatColor
      Reliability Policy: Best Effort
    - Class: rviz_default_plugins/PointCloud2
      Name: TerrainDrop
      Topic:
        Value: terrain_drop
        Queue Size: 5
      Value: true
      Size (m): 0.05
      Style: Points
      Color: 80; 160; 255
      Color Transformer: FlatColor
      Reliability Policy: Best Effort
    - Class: rviz_default_plugins/Map
      Name: KeepoutMask
      Topic:
        Value: /kfs_filter_mask
      Value: true
  Global Options:
    # 参数说明：Fixed Frame - RViz 固定坐标系；所有显示项会转换到该 frame。
    Fixed Frame: odom
    # 参数说明：Frame Rate - RViz 刷新帧率；影响界面更新频率。
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      # 参数说明：Distance - 几何距离参数，单位通常为米。
      Distance: 15
      # 参数说明：Pitch - 俯仰角；单位按该配置约定。
      Pitch: 0.785
      # 参数说明：Yaw - 偏航角；单位按该配置约定，导航图中通常为弧度。
      Yaw: 0
